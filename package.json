{
  "name": "gcp-structured-logger",
  "version": "4.0.2",
  "description": "Structured logger for GCP logging",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "index.js",
    "index.d.ts",
    "express.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./express": {
      "types": "./express.d.ts",
      "default": "./index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookcreator/gcp-structured-logger.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "author": {
    "name": "Rich H",
    "email": "rich@bookcreator.com"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint --cache --fix .",
    "pretest": "eslint --cache",
    "test-debug": "mocha --inspect-brk=50000 --no-timeout",
    "test": "c8 --reporter=text --reporter=html --reporter=text-summary mocha --enable-source-maps",
    "prepack": "npx --no-dry-run -p typescript@6 tsc --allowJs --declaration --emitDeclarationOnly src/*.js",
    "postpack": "rm -f src/*.d.ts",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express-serve-static-core": "^5.1.1",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.2.0",
    "eslint-plugin-mocha": "^11.2.0",
    "eslint-plugin-n": "^17.24.0",
    "mocha": "^11.7.5",
    "sinon": "^21.1.2"
  }
}
